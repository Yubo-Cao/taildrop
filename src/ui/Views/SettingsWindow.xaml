<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TailDrop.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TailDrop">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" PointerPressed="OnRootPointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>
        <TitleBar x:Name="AppTitleBar" Title="TailDrop" IsBackButtonVisible="True" IsBackButtonEnabled="False"
                  BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/app.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Windows Settings layout: account and sections on the left, content on Mica. -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="300"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" ExpandedModeThresholdWidth="900"
                        SelectionChanged="OnNavSelectionChanged" DisplayModeChanged="OnDisplayModeChanged"
                        PaneOpening="OnPaneOpening" PaneClosing="OnPaneClosing">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <Grid x:Name="Account" Padding="16,4,16,16" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64">
                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                        <Image Source="ms-appx:///Assets/app.png" Width="36" Height="36" />
                        <Ellipse x:Name="AccountDot" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                 Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="AccountName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountDetail" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavGeneral" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavReceiving" Tag="receiving">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSending" Tag="sending">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE724;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDevices" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAbout" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- "Devices › ipad", as in Windows Settings -->
                <BreadcrumbBar x:Name="Crumbs" Margin="40,6,40,18" MaxWidth="1000" ItemClicked="OnCrumbClicked">
                    <BreadcrumbBar.Resources>
                        <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                        <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
                        <Thickness x:Key="BreadcrumbBarChevronPadding">12,6,12,0</Thickness>
                    </BreadcrumbBar.Resources>
                </BreadcrumbBar>
                <Frame x:Name="Pages" Grid.Row="1" Navigated="OnNavigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
