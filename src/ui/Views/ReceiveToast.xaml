<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TailDrop.UI.Views.ReceiveToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Top">

    <Grid x:Name="RootGrid" Width="364" VerticalAlignment="Top" Padding="16,6,6,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/app.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="Caption" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="30" Padding="0" Click="OnClose">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <!-- A photo, a strip of thumbnails for several files, or nothing (icon row below). -->
        <Grid x:Name="Preview" Grid.Row="1" Margin="0,4,10,12" CanDrag="True" Background="Transparent"
              DragStarting="OnDragStarting" DropCompleted="OnDropCompleted" Tapped="OnPreviewTapped">
            <Border x:Name="HeroFrame" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" Visibility="Collapsed">
                <Image x:Name="Hero" Stretch="UniformToFill" />
            </Border>
            <Grid x:Name="Strip" ColumnSpacing="6" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconFrame" Width="44" Height="44" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CanDrag="True" DragStarting="OnDragStarting" DropCompleted="OnDropCompleted" Tapped="OnPreviewTapped" Visibility="Collapsed">
                <Grid>
                    <FontIcon x:Name="IconPlaceholder" Glyph="&#xE8A5;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Image x:Name="IconImage" Margin="6" Stretch="Uniform" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="Title" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="SavedGlyph" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- While a file arrives: progress, then speed (or that it is waiting on the sender) and time left. -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,12,10,2" Spacing="6" Visibility="Collapsed">
            <ProgressBar x:Name="Progress" Maximum="1" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLeft" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="DetailRight" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </StackPanel>

        <DropDownButton x:Name="DestButton" Grid.Row="4" Margin="-6,10,0,0" Padding="6,4" Background="Transparent" BorderThickness="0"
                        Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DestLead" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="DestName" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DropDownButton>

        <Grid x:Name="Buttons" Grid.Row="5" Margin="0,12,10,0" ColumnSpacing="4" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnPrimary" />
            <Button x:Name="SecondaryButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnSecondary" />
            <Button x:Name="MoreButton" Grid.Column="2" Width="40" Padding="0" VerticalAlignment="Stretch">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
