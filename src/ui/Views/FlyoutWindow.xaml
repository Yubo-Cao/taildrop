<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TailDrop.UI.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TailDrop.UI.Views"
    Title="TailDrop">

    <Grid x:Name="Root" Width="360" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="16,14,10,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/app.png" Width="24" Height="24" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="TailDrop" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="InboxButton" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnInbox">
                <FontIcon Glyph="&#xE838;" FontSize="16" />
            </Button>
            <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="32" Padding="0" Click="OnSettings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Body -->
        <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Padding="16,6,16,10">
                <Border x:Name="OfflineCard" Style="{StaticResource CardBorderStyle}" Padding="16" Visibility="Collapsed">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;" FontSize="22" VerticalAlignment="Top" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="OfflineTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="OfflineMessage" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <Button x:Name="OpenTailscaleButton" Style="{StaticResource AccentButtonStyle}" Click="OnOpenTailscale" />
                                <Button x:Name="RetryButton" Click="OnRetry" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="OnlinePanel">
                    <TextBlock x:Name="SendLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,2,0,10" />
                    <Grid x:Name="DropZone" AllowDrop="True" Background="Transparent"
                          DragOver="OnZoneDragOver" DragLeave="OnZoneDragLeave" Drop="OnZoneDrop">
                        <Border x:Name="ZoneHighlight" Margin="-6" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Border.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.083" />
                            </Border.OpacityTransition>
                        </Border>
                        <ItemsRepeater x:Name="Tiles">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="100" MinItemHeight="84" MinRowSpacing="8" MinColumnSpacing="8"
                                                   MaximumRowsOrColumns="3" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:DeviceVm">
                                    <Button Tag="{x:Bind Self}" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AllowDrop="True" Click="OnTileClick" RightTapped="OnTileRightTapped"
                                            DragOver="OnTileDragOver" DragLeave="OnTileDragLeave" Drop="OnTileDrop">
                                        <Grid>
                                            <Border CornerRadius="4" BorderThickness="2" Opacity="{x:Bind DropHighlightOpacity, Mode=OneWay}"
                                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}">
                                                <Border.OpacityTransition>
                                                    <ScalarTransition Duration="0:0:0.083" />
                                                </Border.OpacityTransition>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="4" Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="24" />
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource CaptionTextBlockStyle}" FontSize="12" Margin="6,2,6,0" />
                                                <TextBlock x:Uid="TileOffline" Text="Offline" HorizontalAlignment="Center" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind OfflineVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                            <FontIcon Glyph="&#xE735;" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,7,0"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind FavoriteVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock x:Name="NoDevices" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" Margin="2,4,2,12" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,16,-16,8" />

                    <Grid Margin="2,0,0,4">
                        <TextBlock x:Name="ReceivedLabel" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="SaveAllButton" HorizontalAlignment="Right" Click="OnSaveAll" Padding="8,4" />
                    </Grid>
                    <ItemsRepeater x:Name="Rows">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:ItemVm">
                                <Grid Tag="{x:Bind Self}" Height="52" Margin="-8,0,-8,0" Padding="8,0,4,0" CornerRadius="4" Background="Transparent"
                                      ColumnSpacing="12" CanDrag="True" DragStarting="OnRowDragStarting" DropCompleted="OnRowDropCompleted"
                                      PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited"
                                      Tapped="OnRowTapped" RightTapped="OnRowRightTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                            <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="{x:Bind ThumbStretch, Mode=OneWay}"
                                                   Margin="{x:Bind ThumbMargin, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{x:Bind StatusBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="1" Margin="0,4,0,0"
                                                     IsIndeterminate="{x:Bind ProgressIndeterminate, Mode=OneWay}"
                                                     Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SubtleButtonStyle}" Width="34" Height="32" Padding="0" Click="OnRowSave"
                                                Visibility="{x:Bind SaveVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                        </Button>
                                        <Button Style="{StaticResource SubtleButtonStyle}" Width="34" Height="32" Padding="0" Click="OnRowOpen"
                                                Visibility="{x:Bind OpenVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                        </Button>
                                        <Button Style="{StaticResource SubtleButtonStyle}" Width="34" Height="32" Padding="0" Click="OnRowRemove"
                                                Visibility="{x:Bind RemoveVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind RemoveGlyph, Mode=OneWay}" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock x:Name="NoItems" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,2,2,6" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="6,6,10,8">
            <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left" Click="OnInbox">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock x:Name="InboxLabel" />
                </StackPanel>
            </Button>
            <HyperlinkButton x:Name="SavesTo" HorizontalAlignment="Right" Click="OnSettings" FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
