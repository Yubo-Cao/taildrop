<Project Sdk="Microsoft.NET.Sdk">
  <!--
    TailDrop's user interface: WinUI 3, published as a NativeAOT exe with the
    Windows App SDK bundled (no runtime to install). It is started on demand
    by TailDrop.exe (the background listener) and exits when idle.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>TailDrop.UI</RootNamespace>
    <AssemblyName>TailDropUI</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <Product>TailDrop</Product>
    <Company>Yubo Cao</Company>
    <Copyright>MIT License</Copyright>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <!-- TailDrop is translated to English and Chinese only; WinUI's other UI languages just add size. -->
  <Target Name="TrimWinUILanguages" AfterTargets="Publish">
    <ItemGroup>
      <_LangDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <_DropLangDirs Include="@(_LangDirs)"
                     Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^[a-z]{2,3}(-[A-Za-z]+)+$')) and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^(en|zh)-', System.Text.RegularExpressions.RegexOptions.IgnoreCase))" />
    </ItemGroup>
    <RemoveDir Directories="@(_DropLangDirs)" />
  </Target>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Only the Windows App SDK parts WinUI needs (the metapackage also ships AI/ML runtimes). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>
</Project>
