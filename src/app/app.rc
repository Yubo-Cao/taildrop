#include <winres.h>
#include "resource.h"

IDI_APP              ICON "..\\..\\assets\\app.ico"
IDI_TRAY_LIGHT       ICON "..\\..\\assets\\tray-light.ico"
IDI_TRAY_LIGHT_BADGE ICON "..\\..\\assets\\tray-light-badge.ico"
IDI_TRAY_LIGHT_OFF   ICON "..\\..\\assets\\tray-light-off.ico"
IDI_TRAY_DARK        ICON "..\\..\\assets\\tray-dark.ico"
IDI_TRAY_DARK_BADGE  ICON "..\\..\\assets\\tray-dark-badge.ico"
IDI_TRAY_DARK_OFF    ICON "..\\..\\assets\\tray-dark-off.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TD_VERSION_NUM
 PRODUCTVERSION TD_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Yubo Cao"
            VALUE "FileDescription", "TailDrop"
            VALUE "FileVersion", TD_VERSION_STR
            VALUE "InternalName", "TailDrop"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "TailDrop.exe"
            VALUE "ProductName", "TailDrop"
            VALUE "ProductVersion", TD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
